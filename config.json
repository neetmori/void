{
  "app_name": "VOID",
  "version": "3.0",
  "author": "unbeau",
  "request_timeout": 8,
  "port_timeout": 0.5,
  "max_local_stress_requests": 500,
  "default_ports": [
    21,
    22,
    25,
    53,
    80,
    110,
    143,
    443,
    445,
    3306,
    5432,
    8080
  ],
  "subdomains": [
    "www",
    "api",
    "mail",
    "dev",
    "test",
    "staging",
    "blog",
    "shop",
    "cdn",
    "portal",
    "admin"
  ],
  "username_sites": {
    "GitHub": "https://github.com/{username}",
    "Reddit": "https://www.reddit.com/user/{username}",
    "GitLab": "https://gitlab.com/{username}",
    "Keybase": "https://keybase.io/{username}",
    "HackerOne": "https://hackerone.com/{username}",
    "Dev.to": "https://dev.to/{username}"
  }
}